{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "benchmarks-law",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [{ "pattern": "benchmarks.law", "custom_domain": true }],
	// Keep the workers.dev URL live too — the admin passkey was registered on
	// benchmarks-law.cicero-im.workers.dev, and passkeys are bound to that origin.
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "benchmarks-law",
			"database_id": "d9854ec4-1666-4a08-8c97-c5dd26b3856f",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "benchmarks-law-media",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Worker cache layer for Astro route caching (see astro.config.mjs).
	"cache": { "enabled": true },
	// Request logs on; traces off.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": false,
		},
	},
}
