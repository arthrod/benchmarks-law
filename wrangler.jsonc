{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "benchmarks-law",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [{ "pattern": "benchmarks.law", "custom_domain": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "benchmarks-law",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "benchmarks-law-media",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1,
		},
	},
}
