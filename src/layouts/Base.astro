---
import { Font } from "astro:assets";
import { getMenu, getSiteSettings } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashHead } from "emdash/ui";
import "../styles/theme.css";
import "../styles/benchmarks.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || "benchmarks.law";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const tagline = settings?.tagline || "We evaluate. We publish.";
const siteDescription =
	description ||
	"A legal-AI benchmark for attorneys first. We evaluate whoever we choose, with or without authorization, and publish whatever we find. Human-verified ground truth. No LLM judges. No opt-outs.";

// Render the ".law" wordmark accent by splitting the site title on its final dot.
const dot = siteTitle.lastIndexOf(".");
const brandMain = dot > 0 ? siteTitle.slice(0, dot) : siteTitle;
const brandTld = dot > 0 ? siteTitle.slice(dot) : "";

// Kept available for per-project nav wiring; this design uses in-page section anchors.
// const primary = await getMenu("primary");

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: siteDescription,
	canonical: Astro.url.href,
	image,
	seo: { ogImage: image },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/b-law.svg" />
		<title>{fullTitle}</title>
		<meta name="description" content={siteDescription} />
		<EmDashHead page={pageCtx} />
		{/* <Font cssVariable="--font-sans" preload /> — wire local fonts per project; this shell loads Fraunces / Spectral / IBM Plex Mono below. */}
		<!-- font origins -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Google Forms origins: warm the connection so the modal form opens instantly on demand -->
		<link rel="preconnect" href="https://docs.google.com" />
		<link rel="preconnect" href="https://www.google.com" />
		<link rel="dns-prefetch" href="https://docs.google.com" />
		<!-- fonts loaded non-render-blocking -->
		<link
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..700&family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Mono:wght@400;500;600&display=optional"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..700&family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Mono:wght@400;500;600&display=optional"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..700&family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Mono:wght@400;500;600&display=optional"
			/>
		</noscript>
	</head>
	<body>
		<div id="bar"></div>

		<!-- sticky scroll-spy navbar: hidden until the masthead is scrolled past -->
		<div class="stickynav" id="stickynav" inert>
			<div class="inner">
				<a class="brand" href="#manifesto" data-jump="manifesto"
					>{brandMain.charAt(0)}<span class="law">{brandTld}</span></a
				>
				<nav id="spynav">
					<a href="#manifesto" data-jump="manifesto">The Standard</a>
					<a href="#project" data-jump="project">Project</a>
					<a href="#method" data-jump="method">Methodology</a>
					<a href="#contribute" data-jump="contribute">Contribute</a>
					<a href="#provenance" data-jump="provenance">Prior Work</a>
					<a href="#about" data-jump="about">About</a>
				</nav>
			</div>
		</div>

		<header class="mast">
			<div class="wrap">
				<div class="mast-main">
					<h1>{brandMain}<span class="law">{brandTld}</span></h1>
				</div>
			</div>
			<nav class="subnav">
				<a href="#manifesto">The Standard</a>
				<a href="#project">Project</a>
				<a href="#method">Methodology</a>
				<a href="#contribute">Contribute</a>
				<a href="#howto">How to Contribute</a>
				<a href="#provenance">Prior Work</a>
				<a href="#about">About</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer>
			<div class="wrap">
				<div>
					<div class="fm">{brandMain}<span class="law">{brandTld}</span></div>
					<a href="#manifesto" class="toplink" style="color:rgba(242,236,224,.6)"
						>↑ Back to the top</a
					>
				</div>
				<div class="fnote">CC BY 4.0. benchmarks.law ©</div>
			</div>
		</footer>

		<script>
			// Lenis smooth scrolling + sticky scroll-spy navbar + top progress bar.
			import Lenis from "lenis";

			const NAV_OFFSET = 58; // sticky-bar height; used for spy + jump offset
			const SPY_IDS = ["manifesto", "project", "method", "contribute", "provenance", "about"];

			const lenis = new Lenis({
				duration: 1.1,
				easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
				smoothWheel: true,
			});
			function raf(time) {
				lenis.raf(time);
				requestAnimationFrame(raf);
			}
			requestAnimationFrame(raf);

			// Smooth-scroll for [data-jump] links and any in-page #anchor (offset for the nav).
			document.querySelectorAll("[data-jump], a[href^='#']").forEach((a) => {
				a.addEventListener("click", (e) => {
					const id =
						a.getAttribute("data-jump") || (a.getAttribute("href") || "").slice(1);
					const el = id && document.getElementById(id);
					if (el) {
						e.preventDefault();
						lenis.scrollTo(el, { offset: -NAV_OFFSET });
					}
				});
			});

			const bar = document.getElementById("bar");
			const stickynav = document.getElementById("stickynav");
			const spyLinks = document.querySelectorAll("#spynav a");

			function onScroll() {
				const doc = document.documentElement;
				const y = window.scrollY || window.pageYOffset;

				// top progress bar
				const max = (doc.scrollHeight || document.body.scrollHeight) - doc.clientHeight;
				if (bar) bar.style.width = (max > 0 ? (y / max) * 100 : 0) + "%";

				// reveal the sticky bar once the masthead is scrolled past
				const mast = document.querySelector("header.mast");
				const trigger = mast ? mast.offsetHeight - 40 : 240;
				if (stickynav) {
					const shown = y > trigger;
					stickynav.classList.toggle("show", shown);
					// inert (not aria-hidden) so the off-screen nav's focusable links
					// are pulled from both the tab order and the accessibility tree.
					stickynav.inert = !shown;
				}

				// scroll-spy: last section whose top crossed just below the nav
				let current = SPY_IDS[0];
				for (const id of SPY_IDS) {
					const s = document.getElementById(id);
					if (s && s.getBoundingClientRect().top <= NAV_OFFSET + 12) current = id;
				}
				spyLinks.forEach((a) => {
					a.classList.toggle("active", a.getAttribute("data-jump") === current);
				});
			}

			// Lenis updates real scrollTop, so native scroll fires during wheel scroll too.
			window.addEventListener("scroll", onScroll, { passive: true });
			lenis.on("scroll", onScroll);
			onScroll();
		</script>
	</body>
</html>
