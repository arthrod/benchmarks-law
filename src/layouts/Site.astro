---
import { getSiteSettings } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { listReports } from "../lib/cms";
import { navbarHtml } from "../lib/navbar";
import "../styles/site.css";
import "../styles/bench.css";

interface Props {
	title?: string;
	description?: string;
	current?: "home" | "editors";
	/** Shown after the wordmark: "/ {crumb}". Defaults to the title. */
	crumb?: string;
	progress?: boolean;
	noindex?: boolean;
}

const { title, description, current = "home", crumb, progress = false, noindex = false } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || "benchmarks.law";
const fullTitle = title ? `${title} · ${siteTitle}` : `${siteTitle} · DOCX tooling measured against Microsoft Word`;
const siteDescription =
	description ||
	"Open benchmarks of DOCX editors and converters for lawyers: every tool run on the same documents, scored against Microsoft Word, with every input, output and log published.";

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: siteDescription,
	canonical: noindex ? undefined : new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href,
	siteName: siteTitle,
});

const { rows } = await listReports();
const navbar = navbarHtml({
	crumb: crumb ?? title ?? "benchmarks.law",
	current: current === "editors" ? "editors" : "site",
	path: Astro.url.pathname,
	rows,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/b-law.svg" />
		<link rel="preload" href="/fonts/libre-franklin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/roboto-mono.woff2" as="font" type="font/woff2" crossorigin />
		<title>{fullTitle}</title>
		{noindex && <meta name="robots" content="noindex,follow" />}
		<meta name="theme-color" content="#FAFAF8" />
		<link rel="stylesheet" href="/nav.css" />
		<script is:inline src="/nav.js" defer></script>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip" href="#main">Skip to content</a>
		{progress && <div id="progress" aria-hidden="true"></div>}
		<Fragment set:html={navbar} />

		<main id="main">
			<slot />
		</main>

		<footer>
			<div class="wrap">
				<div class="foot-top">
					<span class="c">© MMXXVI benchmarks.law · Arthur Souza Rodrigues · New York · São Paulo</span>
					<div class="foot-social">
						<a href="https://github.com/arthrod/editors_trial" rel="noopener" aria-label="Editors trial on GitHub">GH</a>
						<a href="https://huggingface.co/arthrod" rel="noopener" aria-label="Hugging Face">HF</a>
						<a href="https://arthur.law/" rel="noopener" aria-label="arthur.law">AR</a>
					</div>
				</div>
				<p class="disclaimer">
					<strong>Attorney advertising.</strong> This website is for general informational purposes and does not create an
					attorney-client relationship. Benchmark results describe the named versions on the published inputs only. The
					maintainer also writes Jubarte, one of the tools measured; its rows follow the same rules. Prior results do not
					guarantee a similar outcome.
					<strong>Independent.</strong> benchmarks.law is not affiliated with, sponsored by, or endorsed by any vendor or
					project it measures, Apryse included. Product names are trademarks of their owners.
				</p>
			</div>
		</footer>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
