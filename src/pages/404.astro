---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<section class="blk">
		<div class="wrap">
			<div class="sec-head">
				<span class="n">404</span>
				<div>
					<h3>This page is not on the board.</h3>
					<div class="h-sub">The link is wrong, retired, or never existed</div>
				</div>
			</div>
			<p class="body">
				What you were looking for isn't here. Head back to the standard and find
				your way from the masthead.
			</p>
			<a href="/" class="toplink">↑ Back to benchmarks.law</a>
		</div>
	</section>
</Base>
