---
import Site from "../layouts/Site.astro";
Astro.response.status = 404;
---

<Site title="Not found">
	<div class="wrap">
		<div class="page-head">
			<p class="eyebrow">404<span class="sep">·</span>Not found</p>
			<h1>This page is not on the bench.</h1>
			<p>The link is wrong, retired, or never existed. The reports and the interactive benches are one click away.</p>
			<div class="cta-row" style="margin-top:30px">
				<a class="btn btn-primary" href="/">benchmarks.law <span class="arr">→</span></a>
				<a class="btn btn-ghost" href="/editors-trial/">Editors trial</a>
			</div>
		</div>
	</div>
	<div style="height:72px"></div>
</Site>
